<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#080611"><title>RAVAN: Neon Survival</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#080611;color:white;font-family:system-ui,Arial}body{display:grid;place-items:center;background:radial-gradient(circle at 50% 20%,#281344,#080611 70%)}#gamebox{position:relative;width:min(100vw,560px);height:min(100dvh,900px);min-height:500px;overflow:hidden;background:#090614;border:1px solid #49306b}canvas{width:100%;height:100%;display:block;touch-action:none}.hud{position:absolute;top:16px;left:18px;right:18px;display:flex;justify-content:space-between;pointer-events:none}.brand{font-size:11px;letter-spacing:4px;color:#ffd166;font-weight:900}.muted{font-size:10px;letter-spacing:2px;color:#aaa}.score{text-align:right;font-size:28px;font-weight:900;line-height:1}.bar{position:absolute;top:69px;left:18px;right:18px;height:4px;background:#ffffff20}.bar div{height:100%;width:0;background:linear-gradient(90deg,#ff3d81,#ffd166,#4de8ff)}.overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:22px;background:#080611b9;backdrop-filter:blur(5px)}.panel{max-width:390px;width:100%;text-align:center;padding:28px 20px;border:1px solid #ffffff2b;border-radius:22px;background:linear-gradient(145deg,#211333,#090713);box-shadow:0 0 45px #8a2cff22}.kicker{font-size:10px;letter-spacing:4px;color:#4de8ff;font-weight:900}h1{font-size:clamp(36px,9vw,55px);line-height:.95;letter-spacing:-2px;margin:14px 0}h1 span{color:#ffd166;text-shadow:0 0 24px #ffd16655}.desc{font-size:14px;color:#c9c0d7;line-height:1.6;margin:18px auto}.btn{border:0;border-radius:12px;padding:14px 20px;background:linear-gradient(100deg,#ffd166,#ffad55);color:#140b1a;font-weight:900;letter-spacing:1px;font-size:13px}.small{font-size:11px;line-height:1.7;color:#9a90ab;margin-top:17px}#over{display:none}.controls{position:absolute;bottom:20px;left:0;right:0;display:flex;justify-content:space-between;padding:0 20px;pointer-events:none}.ctrl{pointer-events:auto;width:62px;height:62px;border-radius:50%;border:1px solid #ffffff35;background:#160e2bbd;color:white;font-size:24px;touch-action:none;user-select:none}@media(min-width:600px){#gamebox{height:min(94dvh,900px);border-radius:24px}}
</style></head><body><div id="gamebox"><canvas id="c"></canvas>
<div class="hud"><div><div class="brand">RAVAN ARCADE</div><div class="muted" style="margin-top:5px">NEON SURVIVAL</div></div><div class="score"><span id="score">0</span><div class="muted">SCORE</div></div></div><div class="bar"><div id="prog"></div></div>
<div class="overlay" id="start"><div class="panel"><div class="kicker">✦ ARCADE CHALLENGE ✦</div><h1>RAVAN:<br><span>NEON</span><br>SURVIVAL</h1><div class="desc">Dodge the glowing blocks. Collect cyan orbs. Survive as long as you can!</div><button class="btn" id="play">START GAME ▶</button><div class="small">PC: ← → or A / D<br>Mobile: hold ◀ ▶ buttons<br>Cyan orbs = bonus points</div></div></div>
<div class="overlay" id="over"><div class="panel"><div class="kicker">RUN COMPLETE</div><h1>GAME<br><span>OVER</span></h1><div class="desc">Final score: <b id="final" style="color:#ffd166;font-size:23px">0</b><br><span id="best"></span></div><button class="btn" id="again">PLAY AGAIN ↻</button><div class="small">Tip: make small moves to avoid tricky patterns.</div></div></div>
<div class="controls"><button class="ctrl" id="left">◀</button><button class="ctrl" id="right">▶</button></div></div>
<script>
(()=>{const c=document.querySelector('#c'),x=c.getContext('2d'),box=document.querySelector('#gamebox'),scoreEl=document.querySelector('#score'),prog=document.querySelector('#prog');let W,H,dpr,playing=false,last=0,score=0,best=+(localStorage.ravanBest||0),speed=240,spawn=0,orbtime=2,obs=[],orbs=[],bits=[],stars=[],keys={left:false,right:false},p={x:0,y:0};
function resize(){let r=box.getBoundingClientRect();W=r.width;H=r.height;dpr=Math.min(devicePixelRatio||1,2);c.width=W*dpr;c.height=H*dpr;x.setTransform(dpr,0,0,dpr,0,0);p.y=H-112;p.x=p.x||W/2;stars=Array.from({length:65},()=>({x:Math.random()*W,y:Math.random()*H,s:.5+Math.random()*1.5}))}window.addEventListener('resize',resize);resize();
function background(dt){x.fillStyle='#080611';x.fillRect(0,0,W,H);let g=x.createRadialGradient(W/2,H*.25,0,W/2,H*.25,W*.8);g.addColorStop(0,'#25103c');g.addColorStop(1,'#080611');x.fillStyle=g;x.fillRect(0,0,W,H);stars.forEach(s=>{s.y+=s.s*speed*.12*dt;if(s.y>H){s.y=0;s.x=Math.random()*W}x.globalAlpha=.2+s.s*.3;x.fillStyle=s.s>1.4?'#4de8ff':'#b6a0ff';x.fillRect(s.x,s.y,s.s,s.s)});x.globalAlpha=1;x.strokeStyle='#8c54ff19';for(let i=0;i<=5;i++){x.beginPath();x.moveTo(i*W/5,0);x.lineTo(i*W/5,H);x.stroke()}}
function player(){x.save();x.translate(p.x,p.y);x.shadowBlur=22;x.shadowColor='#4de8ff';x.fillStyle='#4de8ff';x.beginPath();x.moveTo(0,-22);x.lineTo(15,14);x.lineTo(7,20);x.lineTo(-7,20);x.lineTo(-15,14);x.closePath();x.fill();x.shadowBlur=0;x.fillStyle='white';x.beginPath();x.moveTo(0,-12);x.lineTo(5,7);x.lineTo(-5,7);x.fill();x.fillStyle='#ffd166';x.fillRect(-5,21,3,6);x.fillRect(2,21,3,6);x.restore()}
function burst(a,b,col){for(let i=0;i<15;i++){let t=Math.random()*6.28,s=40+Math.random()*150;bits.push({x:a,y:b,vx:Math.cos(t)*s,vy:Math.sin(t)*s,l:.7+Math.random()*.3,m:1,col})}}
function hit(a,b){return Math.abs(a.x-b.x)<(b.w/2+12)&&Math.abs(a.y-b.y)<(b.h/2+14)}
function end(){playing=false;best=Math.max(best,Math.floor(score));localStorage.ravanBest=best;document.querySelector('#final').textContent=Math.floor(score);document.querySelector('#best').textContent='PERSONAL BEST: '+best;document.querySelector('#over').style.display='flex'}
function reset(){score=0;speed=240;spawn=.25;orbtime=1.8;obs=[];orbs=[];bits=[];p.x=W/2;playing=true;last=performance.now();scoreEl.textContent='0';document.querySelector('#start').style.display='none';document.querySelector('#over').style.display='none';requestAnimationFrame(loop)}
document.querySelector('#play').onclick=reset;document.querySelector('#again').onclick=reset;
window.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','a','d','A','D'].includes(e.key))e.preventDefault();if(e.key==='ArrowLeft'||e.key.toLowerCase()==='a')keys.left=true;if(e.key==='ArrowRight'||e.key.toLowerCase()==='d')keys.right=true});window.addEventListener('keyup',e=>{if(e.key==='ArrowLeft'||e.key.toLowerCase()==='a')keys.left=false;if(e.key==='ArrowRight'||e.key.toLowerCase()==='d')keys.right=false});
function bind(id,k){let el=document.getElementById(id);el.onpointerdown=e=>{e.preventDefault();keys[k]=true};['pointerup','pointercancel','pointerleave'].forEach(ev=>el.addEventListener(ev,e=>{e.preventDefault();keys[k]=false}))}bind('left','left');bind('right','right');
function loop(now){if(!playing)return;let dt=Math.min((now-last)/1000,.035);last=now;score+=dt*(10+speed*.025);speed=Math.min(570,240+score*1.3);scoreEl.textContent=Math.floor(score);prog.style.width=(score%500)/5+'%';background(dt);p.x=Math.max(18,Math.min(W-18,p.x+((keys.right?1:0)-(keys.left?1:0))*W*1.2*dt));spawn-=dt;if(spawn<=0){let lane=Math.floor(Math.random()*5),lw=W/5,w=lw*(.43+Math.random()*.15);obs.push({x:lane*lw+lw/2,y:-30,w,h:24+Math.random()*18,vy:speed*(.9+Math.random()*.35),col:Math.random()<.5?'#ff3d81':'#a85cff'});spawn=Math.max(.27,.8-score/1000)+Math.random()*.22}orbtime-=dt;if(orbtime<=0){orbs.push({x:22+Math.random()*(W-44),y:-15,vy:speed*.8,ph:0});orbtime=2.5+Math.random()*2}
for(let o of obs){o.y+=o.vy*dt;x.save();x.translate(o.x,o.y);x.shadowBlur=18;x.shadowColor=o.col;x.fillStyle=o.col;x.beginPath();x.roundRect(-o.w/2,-o.h/2,o.w,o.h,7);x.fill();x.fillStyle='#ffffff55';x.fillRect(-o.w*.25,-o.h*.2,o.w*.5,2);x.restore();if(hit(p,o)){burst(p.x,p.y,'#ff3d81');end();return}}obs=obs.filter(o=>o.y<H+50);
for(let o of orbs){o.y+=o.vy*dt;o.ph+=dt*4;x.save();x.shadowBlur=20;x.shadowColor='#4de8ff';x.strokeStyle='#4de8ff';x.lineWidth=2;x.beginPath();x.arc(o.x,o.y,8+Math.sin(o.ph)*2,0,7);x.stroke();x.fillStyle='white';x.beginPath();x.arc(o.x,o.y,3,0,7);x.fill();x.restore();if(Math.hypot(p.x-o.x,p.y-o.y)<23){score+=50;burst(o.x,o.y,'#4de8ff');o.y=H+100}}orbs=orbs.filter(o=>o.y<H+20);
for(let b of bits){b.x+=b.vx*dt;b.y+=b.vy*dt;b.l-=dt;x.globalAlpha=Math.max(0,b.l/b.m);x.fillStyle=b.col;x.fillRect(b.x,b.y,3,3)}x.globalAlpha=1;bits=bits.filter(b=>b.l>0);player();requestAnimationFrame(loop)}
function idle(){if(!playing){background(.016);player()}requestAnimationFrame(idle)}idle();
})();
</script></body></html>
